<% user_ranking =
  local_assigns.fetch(:user_ranking, false) %>
<% value_title =
  local_assigns.fetch(:value_title, "Eventos") %>

<article class="ranking-card">
  <header class="ranking-card__header">
    <h2><%= title %></h2>
  </header>

  <div class="ranking-card__table-wrapper">
    <table class="ranking-table">
      <thead>
        <tr>
          <th><%= column_title %></th>
          <th><%= value_title %></th>
        </tr>
      </thead>

      <tbody>
        <% rows.each do |row| %>
          <% directory_user =
            user_ranking ? row[:directory_user] : nil %>
          <% row_url = row[:url].presence %>

          <tr class="<%= "ranking-table__row--link" if row_url %>">
            <td title="<%= row[:label] %>">
              <% if directory_user.present? %>
                <% user_name =
                  directory_user.display_name.presence ||
                  directory_user.user_principal_name.presence ||
                  "Usuario" %>

                <%= link_to(
                  user365_path(directory_user,
                  return_to: request.fullpath),
                  class: "audit-user-cell audit-user-cell--link",
                  aria: {
                    label: "Ver perfil de #{user_name}"
                  }
                ) do %>
                  <span class="audit-user-cell__avatar">
                    <%= user_name.first.upcase %>
                  </span>

                  <span class="audit-user-cell__content">
                    <strong>
                      <%= directory_user.display_name.presence ||
                        "Sin nombre" %>
                    </strong>

                    <small
                      title="<%= directory_user.user_principal_name %>"
                    >
                      <%= directory_user.user_principal_name.presence ||
                        row[:label] %>
                    </small>
                  </span>
                <% end %>
              <% elsif user_ranking %>
                <% user_label =
                  audit_user_display_label(row[:label]) %>

                <div class="audit-user-cell">
                  <span class="audit-user-cell__avatar">
                    <%= user_label.first.upcase %>
                  </span>

                  <span title="<%= user_label %>">
                    <%= user_label %>
                  </span>
                </div>
              <% elsif row_url %>
                <%= link_to row[:label], row_url, class: "ranking-table__label-link" %>
              <% else %>
                <%= row[:label] %>
              <% end %>
            </td>

            <td>
              <% if row_url && directory_user.blank? %>
                <%= link_to(
                  number_with_delimiter(row[:events]),
                  row_url,
                  class: "ranking-table__label-link"
                ) %>
              <% else %>
                <%= number_with_delimiter(row[:events]) %>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if rows.empty? %>
          <tr>
            <td colspan="2" class="ranking-table__empty">
              No se encontraron datos para el periodo.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</article>

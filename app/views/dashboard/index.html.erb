  <section class="dashboard__range">
    Mostrando información del
    <strong><%= l(@date_range.from, format: :long) %></strong>
    al
    <strong><%= l(@date_range.to - 1.day, format: :long) %></strong>
  </section>

  <section class="metric-grid">
    <article class="metric-card">
      <span class="metric-card__label">Usuarios</span>
      <strong class="metric-card__value">
        <%= number_with_delimiter(@metrics[:total_users]) %>
      </strong>
      <small aria-hidden="true">&nbsp;</small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">Movimientos</span>
      <strong class="metric-card__value">
        <%= number_with_delimiter(@metrics[:total_events]) %>
      </strong>
      <small aria-hidden="true">&nbsp;</small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">Movimientos anónimos</span>
      <strong class="metric-card__value">
        <%= number_with_delimiter(@metrics[:anonymous_events]) %>
      </strong>

      <small>
        <%= percentage(
          @metrics[:anonymous_events],
          @metrics[:total_events]
        ) %>
      </small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">Archivos</span>
      <strong class="metric-card__value">
        <%= number_with_delimiter(@metrics[:total_files]) %>
      </strong>
      <small aria-hidden="true">&nbsp;</small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">Archivos anónimos</span>
      <strong class="metric-card__value">
        <%= number_with_delimiter(@metrics[:anonymous_files]) %>
      </strong>

      <small>
        <%= percentage(
          @metrics[:anonymous_files],
          @metrics[:total_files]
        ) %>
      </small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">Aplicaciones</span>
      <strong class="metric-card__value">
        <%= number_with_delimiter(@metrics[:total_applications]) %>
      </strong>
      <small aria-hidden="true">&nbsp;</small>
    </article>
  </section>

  <section class="ranking-grid">
    <%= render "ranking",
      title: "Top usuarios",
      column_title: "Usuario",
      rows: @top_users %>

    <%= render "ranking",
      title: "Top acciones",
      column_title: "Acción",
      rows: @top_actions %>

    <%= render "ranking",
      title: "Top aplicaciones",
      column_title: "Aplicación",
      rows: @top_applications %>
  </section>
</div>
<% content_for :title, "Iniciar sesión | AuditORVE" %>

<section class="login-page">
  <div class="login-card">

    <header class="login-card__header">
      <p class="login-card__eyebrow">
        AuditORVE
      </p>

      <h1>
        Iniciar sesión
      </h1>

      <p>
        Ingresa tus credenciales para acceder al sistema de auditoría.
      </p>
    </header>


    <%= form_with(
      url: login_path,
      scope: :session,
      method: :post,
      local: true,
      class: "login-form"
    ) do |form| %>

      <div class="login-form__field">
        <%= form.label(
          :usuario,
          "Correo electrónico"
        ) %>

        <%= form.email_field(
          :usuario,
          value: params.dig(
            :session,
            :usuario
          ),
          autocomplete: "username",
          autofocus: true,
          required: true,
          placeholder: "usuario@grupoorve.mx"
        ) %>
      </div>


      <div class="login-form__field">
        <%= form.label(
          :password,
          "Contraseña"
        ) %>

        <%= form.password_field(
          :password,
          autocomplete: "current-password",
          required: true,
          placeholder: "Ingresa tu contraseña"
        ) %>
      </div>


      <%= form.submit(
        "Iniciar sesión",
        class: "button button--primary login-form__submit"
      ) %>


      <div class="login-form__recovery">
        <span>
          ¿Olvidaste tu contraseña?
        </span>

        <%= link_to(
          "Recuperar",
          forgot_password_path,
          class: "login-form__recovery-link"
        ) %>
      </div>

    <% end %>

  </div>
</section>
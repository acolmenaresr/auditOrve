<!DOCTYPE html>
<html>
  <head>
  <title><%= content_for(:title) || "Audit Orve" %></title>

  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Audit Orve">
  <meta name="mobile-web-app-capable" content="yes">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="icon" href="/auditorve-favicon-v3.png?v=3" type="image/png">
  <link rel="apple-touch-icon" href="/auditorve-favicon-v3.png?v=3">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

  <%= stylesheet_link_tag(
    "application",
    "data-turbo-track": "reload"
  ) %>

  <script
    src="https://cdn.jsdelivr.net/npm/tom-select@2.6.2/dist/js/tom-select.complete.min.js"
    data-turbo-track="reload"
  ></script>

  <%= javascript_importmap_tags %>
</head>

<body>
  <% if authenticated? %>
    <header class="app-header">
      <div class="app-header__brand">
        <strong>AuditORVE</strong>
      </div>

    <nav class="app-header__navigation">
      <%= link_to "Dashboard", dashboard_path %>
      <%= link_to "Movimientos", audit_logs_path %>
      <%= link_to "Usuarios 365", users365_path %>
      <%= link_to "Cloud Orve", cloudorve_path%>
    </nav>

      <div class="app-header__session">
        <div class="app-header__user">
          <strong>
            <%= current_user.first_name.presence || current_user.usuario %>
          </strong>

          <small>
            <%= current_user.usuario %>
          </small>
        </div>

        <%= button_to(
          "Cerrar sesión",
          logout_path,
          method: :delete,
          class: "button button--secondary"
        ) %>
      </div>
    </header>
  <% end %>

<% if notice.present? %>
  <div class="flash flash--notice" data-auto-dismiss-flash>
    <span><%= notice %></span>

    <button
      type="button"
      class="flash__close"
      aria-label="Cerrar mensaje"
      data-flash-close
    >
      ×
    </button>
  </div>
<% end %>

<% if alert.present? %>
  <div class="flash flash--alert" data-auto-dismiss-flash>
    <span><%= alert %></span>

    <button
      type="button"
      class="flash__close"
      aria-label="Cerrar mensaje"
      data-flash-close
    >
      ×
    </button>
  </div>
<% end %>

  <%= yield %>
<script>
  (() => {
    const initializeFlashMessages = () => {
      document
        .querySelectorAll("[data-auto-dismiss-flash]")
        .forEach((flash) => {
          if (flash.dataset.initialized === "true") return

          flash.dataset.initialized = "true"

          const closeFlash = () => {
            flash.classList.add("is-hiding")

            window.setTimeout(() => {
              flash.remove()
            }, 250)
          }

          const closeButton = flash.querySelector("[data-flash-close]")

          if (closeButton) {
            closeButton.addEventListener("click", closeFlash)
          }

          window.setTimeout(closeFlash, 4000)
        })
    }

    document.addEventListener("turbo:load", initializeFlashMessages)
    document.addEventListener("DOMContentLoaded", initializeFlashMessages)

    initializeFlashMessages()
  })()
</script>
</body>
</html>

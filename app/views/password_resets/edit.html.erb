<section class="password-reset-page">
  <div class="password-reset-card">
    <div class="password-reset-card__brand">
      <strong>AuditORVE</strong>
    </div>

    <% if @token_valid %>
      <%
        reset_name = [
          @reset_user[:firstname],
          @reset_user[:lastname]
        ].reject(&:blank?).join(" ")
      %>

      <header class="password-reset-card__header">
        <h1>
          Restablecer contraseña
        </h1>

        <% if reset_name.present? %>
          <p class="password-reset-card__greeting">
            Hola <strong><%= reset_name %></strong>
          </p>
        <% end %>

        <p>
          Ingresa una nueva contraseña para
        </p>

        <strong class="password-reset-card__email">
          <%= @reset_user[:email] %>
        </strong>
      </header>

      <% if @error_message.present? %>
        <div
          class="password-reset-alert password-reset-alert--error"
          role="alert"
        >
          <%= @error_message %>
        </div>
      <% end %>

      <%= form_with(
        url: update_password_path,
        method: :patch,
        local: true,
        class: "password-reset-form",
        data: {
          controller: "password-rules"
        }
      ) do |form| %>

        <%= form.hidden_field(
          :token,
          value: @token
        ) %>

        <div class="password-reset-field">
          <%= form.label(
            :password,
            "Nueva contraseña"
          ) %>

          <div class="password-input-wrapper">
            <%= form.password_field(
              :password,
              required: true,
              minlength: 8,
              autocomplete: "new-password",
              autofocus: true,
              class: "password-input-with-toggle",
              data: {
                password_rules_target: "password",
                action: "input->password-rules#validate"
              }
            ) %>

            <button
              type="button"
              class="password-visibility-toggle"
              data-password-rules-target="passwordToggle"
              data-action="click->password-rules#togglePassword"
              aria-label="Mostrar contraseña"
              aria-pressed="false"
            >
              <svg
                class="password-eye"
                data-eye-show
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="3"
                />
              </svg>

              <svg
                class="password-eye is-hidden"
                data-eye-hide
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M3 3 21 21"
                />

                <path
                  d="M10.7 6.1A10.5 10.5 0 0 1 12 6c6.5 0 10 6 10 6a16.5 16.5 0 0 1-3 3.8"
                />

                <path
                  d="M6.5 6.5C3.8 8.4 2 12 2 12s3.5 6 10 6a10.5 10.5 0 0 0 4-.8"
                />
              </svg>
            </button>
          </div>
        </div>

        <div class="password-reset-rules">
          <p>
            La contraseña debe contener:
          </p>

          <ul>
            <li
              class="password-rule password-rule--pending"
              data-password-rules-target="lengthRule"
            >
              <span data-password-rule-icon>○</span>
              <span>Mínimo 8 caracteres</span>
            </li>

            <li
              class="password-rule password-rule--pending"
              data-password-rules-target="uppercaseRule"
            >
              <span data-password-rule-icon>○</span>
              <span>Al menos una letra mayúscula</span>
            </li>

            <li
              class="password-rule password-rule--pending"
              data-password-rules-target="lowercaseRule"
            >
              <span data-password-rule-icon>○</span>
              <span>Al menos una letra minúscula</span>
            </li>

            <li
              class="password-rule password-rule--pending"
              data-password-rules-target="specialRule"
            >
              <span data-password-rule-icon>○</span>
              <span>Al menos un carácter especial</span>
            </li>
          </ul>
        </div>

        <div class="password-reset-field">
          <%= form.label(
            :password_confirmation,
            "Confirmar contraseña"
          ) %>

          <div class="password-input-wrapper">
            <%= form.password_field(
              :password_confirmation,
              required: true,
              minlength: 8,
              autocomplete: "new-password",
              class: "password-input-with-toggle",
              data: {
                password_rules_target: "confirmation",
                action: "input->password-rules#validate"
              }
            ) %>

            <button
              type="button"
              class="password-visibility-toggle"
              data-password-rules-target="confirmationToggle"
              data-action="click->password-rules#toggleConfirmation"
              aria-label="Mostrar contraseña"
              aria-pressed="false"
            >
              <svg
                class="password-eye"
                data-eye-show
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="3"
                />
              </svg>

              <svg
                class="password-eye is-hidden"
                data-eye-hide
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M3 3 21 21"
                />

                <path
                  d="M10.7 6.1A10.5 10.5 0 0 1 12 6c6.5 0 10 6 10 6a16.5 16.5 0 0 1-3 3.8"
                />

                <path
                  d="M6.5 6.5C3.8 8.4 2 12 2 12s3.5 6 10 6a10.5 10.5 0 0 0 4-.8"
                />
              </svg>
            </button>
          </div>

          <p
            class="password-match password-match--pending"
            data-password-rules-target="matchMessage"
            aria-live="polite"
          >
            Confirma nuevamente tu contraseña.
          </p>
        </div>

        <%= form.submit(
          "Actualizar contraseña",
          class: "password-reset-submit",
          disabled: true,
          data: {
            password_rules_target: "submit"
          }
        ) %>
      <% end %>

    <% else %>
      <header class="password-reset-card__header">
        <h1>
          Enlace no disponible
        </h1>

        <p>
          <%= @error_message.presence ||
              "El enlace de recuperación no es válido." %>
        </p>
      </header>

      <%= link_to(
        "Volver al inicio de sesión",
        login_path,
        class: "password-reset-login-link"
      ) %>
    <% end %>
  </div>
</section>
<div class="dashboard">
  <section class="dashboard__range">
    Mostrando alertas del
    <strong><%= l(@date_range.from, format: :long) %></strong>
    al
    <strong><%= l(@date_range.to - 1.day, format: :long) %></strong>
  </section>

  <%= render(
    "shared/alert_metric_cards",
    metrics: @metrics,
    total_caption: "Según filtros actuales",
    total_url: alert_filter_path(estado: nil, severidad: nil, asignacion: @assignment),
    unassigned_url: alert_filter_path(asignacion: "sin_asignar", estado: nil),
    in_progress_url: alert_filter_path(estado: "en_trabajo"),
    finished_url: alert_filter_path(estado: "finalizadas"),
    critica_url: alert_filter_path(severidad: "critica"),
    alta_url: alert_filter_path(severidad: "alta"),
    media_url: alert_filter_path(severidad: "media"),
    baja_url: alert_filter_path(severidad: "baja"),
    total_active: @status.blank? && @severity.blank? && @assignment.blank?,
    unassigned_active: @assignment.to_s == "sin_asignar",
    in_progress_active: @status.to_s == "en_trabajo",
    finished_active: @status.to_s == "finalizadas"
  ) %>

  <section class="audit-filters">
    <%= form_with(
      url: alerts_path,
      method: :get,
      local: true,
      class: "audit-filters__form audit-filters__form--alerts",
      id: "alerts-filters-form"
    ) do |form| %>
      <div class="audit-filter-field">
        <%= form.label :period, "Periodo" %>
        <%= form.select(
          :period,
          options_for_select(
            [
              [ "Hoy", "today" ],
              [ "Ayer", "yesterday" ],
              [ "Últimos 7 días", "last_7_days" ],
              [ "Últimos 30 días", "last_30_days" ],
              [ "Esta semana", "this_week" ],
              [ "Semana pasada", "last_week" ],
              [ "Este mes", "this_month" ],
              [ "Mes pasado", "last_month" ],
              [ "Este año", "this_year" ],
              [ "Personalizado", "custom" ]
            ],
            @date_range.filter
          ),
          {},
          { id: "alerts-date-filter" }
        ) %>
      </div>

      <div
        class="
          audit-filter-field
          audit-custom-date
          <%= "is-hidden" unless @date_range.filter == "custom" %>
        "
        data-alerts-custom-date
      >
        <%= form.label :from, "Desde" %>
        <%= form.date_field(
          :from,
          value: params[:from],
          id: "alerts-date-from"
        ) %>
      </div>

      <div
        class="
          audit-filter-field
          audit-custom-date
          <%= "is-hidden" unless @date_range.filter == "custom" %>
        "
        data-alerts-custom-date
      >
        <%= form.label :to, "Hasta" %>
        <%= form.date_field(
          :to,
          value: params[:to],
          id: "alerts-date-to"
        ) %>
      </div>

      <div class="audit-filter-field">
        <%= form.label :asignacion, "Asignación" %>
        <%= form.select(
          :asignacion,
          options_for_select(
            alert_assignment_filter_options,
            @assignment
          )
        ) %>
      </div>

      <div class="audit-filter-field">
        <%= form.label :estado, "Estado" %>
        <%= form.select(
          :estado,
          options_for_select(
            [
              [ "Todos", "" ],
              [ "Activas", "activas" ],
              [ "Pendiente", "pendiente" ],
              [ "En trabajo", "en_trabajo" ],
              [ "Asignada", "asignada" ],
              [ "En revisión", "en_revision" ],
              [ "Finalizadas", "finalizadas" ],
              [ "Atendida", "resuelta" ],
              [ "Descartada", "descartada" ]
            ],
            @status
          )
        ) %>
      </div>

      <div class="audit-filter-field">
        <%= form.label :severidad, "Severidad" %>
        <%= form.select(
          :severidad,
          options_for_select(
            [
              [ "Todas", "" ],
              [ "Crítica", "critica" ],
              [ "Alta", "alta" ],
              [ "Media", "media" ],
              [ "Baja", "baja" ]
            ],
            @severity
          )
        ) %>
      </div>

      <div class="audit-filter-field audit-filter-field--motive">
        <%= form.label :motivo, "Motivo" %>
        <%= form.select(
          :motivo,
          options_for_select(
            [ [ "Todos", "" ] ] +
              @motive_options.map { |value|
                [ alert_motive_filter_label(value), value ]
              },
            @motive
          ),
          {},
          {
            class: "js-searchable-select",
            data: { placeholder: "Todos los motivos" }
          }
        ) %>
      </div>

      <div class="filter-actions">
        <%= form.submit "Aplicar", class: "button button--primary" %>
        <%= link_to "Limpiar", alerts_path, class: "button button--secondary" %>
      </div>
    <% end %>
  </section>

  <% if @show_open_table %>
    <%= render(
      "audit_notifications/alerts_table",
      title: "Pendientes",
      records: @open_records,
      total_count: @open_total_count,
      page: @page,
      total_pages: @open_total_pages,
      page_param: :page
    ) %>
  <% end %>

  <% if @show_closed_table %>
    <%= render(
      "audit_notifications/alerts_table",
      title: "Finalizadas",
      records: @closed_records,
      total_count: @closed_total_count,
      page: @closed_page,
      total_pages: @closed_total_pages,
      page_param: :page_finalizadas
    ) %>
  <% end %>
</div>

<script>
  (() => {
    const initializeAlertDateFilters = () => {
      const periodSelect = document.getElementById("alerts-date-filter")
      const customDateFields = document.querySelectorAll(
        "[data-alerts-custom-date]"
      )

      if (!periodSelect || customDateFields.length === 0) {
        return
      }

      const toggleCustomDates = () => {
        const isCustom = periodSelect.value === "custom"

        customDateFields.forEach((field) => {
          field.classList.toggle("is-hidden", !isCustom)
        })
      }

      periodSelect.addEventListener("change", toggleCustomDates)
      toggleCustomDates()
    }

    document.addEventListener("turbo:load", initializeAlertDateFilters)
    initializeAlertDateFilters()
  })()
</script>

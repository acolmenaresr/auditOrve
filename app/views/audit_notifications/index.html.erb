<div class="dashboard">
  <section class="dashboard__range">
    Mostrando alertas del
    <strong><%= l(@date_range.from, format: :long) %></strong>
    al
    <strong><%= l(@date_range.to - 1.day, format: :long) %></strong>
  </section>

  <section class="metric-grid metric-grid--alerts">
    <%= link_to(
      alert_filter_path(estado: nil, severidad: nil),
      class: alert_metric_card_class(:all, nil)
    ) do %>
      <article>
        <span class="metric-card__label">Notificaciones</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:total]) %>
        </strong>
        <small>Total del periodo</small>
      </article>
    <% end %>

    <%= link_to(
      alert_filter_path(estado: "pendiente"),
      class: alert_metric_card_class(:estado, "pendiente")
    ) do %>
      <article>
        <span class="metric-card__label">Pendientes</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:pendiente]) %>
        </strong>
        <small>Sin asignar</small>
      </article>
    <% end %>

    <%= link_to(
      alert_filter_path(estado: "en_trabajo"),
      class: alert_metric_card_class(:estado, "en_trabajo")
    ) do %>
      <article>
        <span class="metric-card__label">En trabajo</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:en_trabajo]) %>
        </strong>
        <small>Asignadas o en revisión</small>
      </article>
    <% end %>

    <%= link_to(
      alert_filter_path(estado: "resuelta"),
      class: alert_metric_card_class(:estado, "resuelta")
    ) do %>
      <article>
        <span class="metric-card__label">Atendidas</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:atendida]) %>
        </strong>
        <small>Resueltas</small>
      </article>
    <% end %>
  </section>

  <section class="metric-grid metric-grid--alerts">
    <%= link_to(
      alert_filter_path(severidad: "critica"),
      class: alert_metric_card_class(:severidad, "critica")
    ) do %>
      <article>
        <span class="metric-card__label">Críticas</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:critica]) %>
        </strong>
        <small>
          <%= percentage(@metrics[:critica], @metrics[:total]) %>
        </small>
      </article>
    <% end %>

    <%= link_to(
      alert_filter_path(severidad: "alta"),
      class: alert_metric_card_class(:severidad, "alta")
    ) do %>
      <article>
        <span class="metric-card__label">Altas</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:alta]) %>
        </strong>
        <small>
          <%= percentage(@metrics[:alta], @metrics[:total]) %>
        </small>
      </article>
    <% end %>

    <%= link_to(
      alert_filter_path(severidad: "media"),
      class: alert_metric_card_class(:severidad, "media")
    ) do %>
      <article>
        <span class="metric-card__label">Medias</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:media]) %>
        </strong>
        <small>
          <%= percentage(@metrics[:media], @metrics[:total]) %>
        </small>
      </article>
    <% end %>

    <%= link_to(
      alert_filter_path(severidad: "baja"),
      class: alert_metric_card_class(:severidad, "baja")
    ) do %>
      <article>
        <span class="metric-card__label">Bajas</span>
        <strong class="metric-card__value">
          <%= number_with_delimiter(@metrics[:baja]) %>
        </strong>
        <small>
          <%= percentage(@metrics[:baja], @metrics[:total]) %>
        </small>
      </article>
    <% end %>
  </section>

  <section class="audit-filters">
    <%= form_with(
      url: alerts_path,
      method: :get,
      local: true,
      class: "audit-filters__form",
      id: "alerts-filters-form"
    ) do |form| %>
      <div class="audit-filter-field">
        <%= form.label :period, "Periodo" %>
        <%= form.select(
          :period,
          options_for_select(
            [
              [ "Hoy", "today" ],
              [ "Ayer", "yesterday" ],
              [ "Últimos 7 días", "last_7_days" ],
              [ "Últimos 30 días", "last_30_days" ],
              [ "Esta semana", "this_week" ],
              [ "Semana pasada", "last_week" ],
              [ "Este mes", "this_month" ],
              [ "Mes pasado", "last_month" ],
              [ "Este año", "this_year" ],
              [ "Personalizado", "custom" ]
            ],
            @date_range.filter
          ),
          {},
          { id: "alerts-date-filter" }
        ) %>
      </div>

      <div
        class="
          audit-filter-field
          audit-custom-date
          <%= "is-hidden" unless @date_range.filter == "custom" %>
        "
        data-alerts-custom-date
      >
        <%= form.label :from, "Desde" %>
        <%= form.date_field(
          :from,
          value: params[:from],
          id: "alerts-date-from"
        ) %>
      </div>

      <div
        class="
          audit-filter-field
          audit-custom-date
          <%= "is-hidden" unless @date_range.filter == "custom" %>
        "
        data-alerts-custom-date
      >
        <%= form.label :to, "Hasta" %>
        <%= form.date_field(
          :to,
          value: params[:to],
          id: "alerts-date-to"
        ) %>
      </div>

      <div class="audit-filter-field">
        <%= form.label :asignacion, "Asignación" %>
        <%= form.select(
          :asignacion,
          options_for_select(
            alert_assignment_filter_options,
            @assignment
          )
        ) %>
      </div>

      <div class="audit-filter-field">
        <%= form.label :estado, "Estado" %>
        <%= form.select(
          :estado,
          options_for_select(
            [
              [ "Todos", "" ],
              [ "Pendiente", "pendiente" ],
              [ "En trabajo", "en_trabajo" ],
              [ "Asignada", "asignada" ],
              [ "En revisión", "en_revision" ],
              [ "Atendida", "resuelta" ],
              [ "Descartada", "descartada" ]
            ],
            @status
          )
        ) %>
      </div>

      <div class="audit-filter-field">
        <%= form.label :severidad, "Severidad" %>
        <%= form.select(
          :severidad,
          options_for_select(
            [
              [ "Todas", "" ],
              [ "Crítica", "critica" ],
              [ "Alta", "alta" ],
              [ "Media", "media" ],
              [ "Baja", "baja" ]
            ],
            @severity
          )
        ) %>
      </div>

      <div class="filter-actions">
        <%= form.submit "Aplicar", class: "button button--primary" %>
        <%= link_to "Limpiar", alerts_path, class: "button button--secondary" %>
      </div>
    <% end %>
  </section>

  <section class="audit-table-card">
    <div class="audit-summary">
      <div>
        <strong><%= number_with_delimiter(@total_count) %></strong>
        <span>alertas en la tabla</span>
      </div>
    </div>

    <div class="audit-table-wrapper">
      <table class="audit-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Severidad</th>
            <th>Estado</th>
            <th>Tipo de alerta</th>
            <th>Usuario</th>
            <th>Acción</th>
            <th>Archivo</th>
            <th>Motivo</th>
            <th>Asignado a</th>
          </tr>
        </thead>
        <tbody>
          <% if @records.any? %>
            <% @records.each do |record| %>
              <% audit_user_email = record["usuario"].to_s.strip %>
              <% directory_user =
                @directory_users_by_email[audit_user_email.downcase] %>
              <% occurred_at = record.occurred_at %>

              <tr>
                <td class="audit-table__date">
                  <%= link_to alert_path(record, return_to: request.fullpath), class: "audit-alert-link" do %>
                    <span class="audit-table__date-short">
                      <%= alert_table_datetime(occurred_at) %>
                    </span>
                  <% end %>
                </td>

                <td>
                  <span class="audit-badge audit-badge--<%= record["severidad"].to_s.parameterize %>">
                    <%= alert_severity_label(record["severidad"]) %>
                  </span>
                </td>

                <td>
                  <span class="audit-badge audit-badge--<%= record["estado"].to_s.parameterize %>">
                    <%= alert_status_label(record["estado"]) %>
                  </span>
                </td>

                <td>
                  <%= link_to alert_path(record, return_to: request.fullpath), class: "audit-alert-link" do %>
                    <strong title="<%= record["tipoAlerta"] %>">
                      <%= alert_type_label(record["tipoAlerta"]) %>
                    </strong>
                  <% end %>
                </td>

                <td>
                  <% if directory_user.present? %>
                    <% user_name =
                      directory_user.display_name.presence ||
                      directory_user.user_principal_name.presence ||
                      "Usuario" %>

                    <%= link_to(
                      user365_path(
                        directory_user,
                        return_to: request.fullpath
                      ),
                      class: "audit-user-cell audit-user-cell--link",
                      aria: { label: "Ver dashboard de #{user_name}" }
                    ) do %>
                      <span class="audit-user-cell__avatar">
                        <%= user_name.first.upcase %>
                      </span>
                      <span class="audit-user-cell__content">
                        <strong>
                          <%= directory_user.display_name.presence || "Sin nombre" %>
                        </strong>
                        <small>
                          <%= directory_user.user_principal_name.presence ||
                            audit_user_email %>
                        </small>
                      </span>
                    <% end %>
                  <% else %>
                    <div class="audit-user-cell">
                      <span class="audit-user-cell__avatar">
                        <%= audit_user_email.first&.upcase || "?" %>
                      </span>
                      <span title="<%= audit_user_email %>">
                        <%= audit_user_email.presence || "Sin usuario" %>
                      </span>
                    </div>
                  <% end %>
                </td>

                <td>
                  <%= record["accion"].presence || "—" %>
                </td>

                <td class="audit-table__file">
                  <span title="<%= record["archivo"] %>">
                    <%= record["archivo"].presence || "—" %>
                  </span>
                </td>

                <td class="audit-table__motivo">
                  <%= record["motivo"].presence || "—" %>
                </td>

                <td class="audit-table__assign">
                  <%= render(
                    "audit_notifications/assign_select",
                    record: record,
                    can_assign: @can_assign_alerts,
                    assignable_users: @assignable_alert_users,
                    return_to: request.fullpath
                  ) %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="audit-table__empty">
                <div>
                  <strong>No hay alertas para el filtro seleccionado.</strong>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_count.positive? %>
      <footer class="audit-pagination">
        <div>
          Página
          <strong><%= @page %></strong>
          de
          <strong><%= @total_pages %></strong>
        </div>

        <nav
          class="audit-pagination__controls"
          aria-label="Paginación de alertas"
        >
          <% preserved_params = request.query_parameters.except("page") %>

          <% if @page > 1 %>
            <%= link_to(
              "← Anterior",
              alerts_path(preserved_params.merge(page: @page - 1)),
              class: "audit-pagination__button"
            ) %>
          <% else %>
            <span class="audit-pagination__button is-disabled">
              ← Anterior
            </span>
          <% end %>

          <span class="audit-pagination__current"><%= @page %></span>

          <% if @page < @total_pages %>
            <%= link_to(
              "Siguiente →",
              alerts_path(preserved_params.merge(page: @page + 1)),
              class: "audit-pagination__button"
            ) %>
          <% else %>
            <span class="audit-pagination__button is-disabled">
              Siguiente →
            </span>
          <% end %>
        </nav>
      </footer>
    <% end %>
  </section>
</div>

<script>
  (() => {
    const initializeAlertDateFilters = () => {
      const periodSelect = document.getElementById("alerts-date-filter")
      const customDateFields = document.querySelectorAll(
        "[data-alerts-custom-date]"
      )

      if (!periodSelect || customDateFields.length === 0) {
        return
      }

      const toggleCustomDates = () => {
        const isCustom = periodSelect.value === "custom"

        customDateFields.forEach((field) => {
          field.classList.toggle("is-hidden", !isCustom)
        })
      }

      periodSelect.addEventListener("change", toggleCustomDates)
      toggleCustomDates()
    }

    document.addEventListener("turbo:load", initializeAlertDateFilters)
    initializeAlertDateFilters()
  })()
</script>

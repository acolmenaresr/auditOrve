<div class="dashboard">
  <header class="dashboard__header">
    <div>
      <p class="dashboard__eyebrow">
        Cloud Orve
      </p>

      <h1>
        Auditoría de nomenclatura
      </h1>

      <p class="dashboard__subtitle">
        Resumen de cumplimiento de carpetas y archivos almacenados
        en Microsoft 365.
      </p>
    </div>

    <%= link_to "Ver Audit Drive",
                cloudorve_drives_path,
                class: "button button--secondary" %>
  </header>

  <section class="metric-grid metric-grid--centered">
    <article class="metric-card">
      <span class="metric-card__label">
        Drives activos
      </span>

      <strong class="metric-card__value">
        <%= number_with_delimiter(
          @overview[:active_drives_count]
        ) %>
      </strong>

      <small>
        Fuentes incluidas en la auditoría
      </small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">
        Carpetas
      </span>

      <strong class="metric-card__value">
        <%= number_with_delimiter(
          @overview[:folders_count]
        ) %>
      </strong>

      <small>
        <% percentage =
          @overview[:folders_compliance_percentage] %>

        <% if percentage.nil? %>
          Sin datos de cumplimiento
        <% else %>
          Cumplimiento:
          <%= number_with_precision(
            percentage,
            precision: 2,
            strip_insignificant_zeros: true
          ) %> %
        <% end %>
      </small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">
        Archivos
      </span>

      <strong class="metric-card__value">
        <%= number_with_delimiter(
          @overview[:files_count]
        ) %>
      </strong>

      <small>
        <% percentage =
          @overview[:files_compliance_percentage] %>

        <% if percentage.nil? %>
          Sin datos de cumplimiento
        <% else %>
          Cumplimiento:
          <%= number_with_precision(
            percentage,
            precision: 2,
            strip_insignificant_zeros: true
          ) %> %
        <% end %>
      </small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">
        Pendientes de evaluación
      </span>

      <strong class="metric-card__value">
        <%= number_with_delimiter(
          @overview[:pending_items_count]
        ) %>
      </strong>

      <small>
        Sin auditar o en revisión
      </small>
    </article>

    <article class="metric-card">
      <span class="metric-card__label">
        No auditables
      </span>

      <strong class="metric-card__value">
        <%= number_with_delimiter(
          @overview[:non_auditable_items_count]
        ) %>
      </strong>

      <small>
        Excluidos o sin regla aplicable
      </small>
    </article>
  </section>

  <div class="cloudorve-dashboard-tables">
    <%= render "drives_table",
               title: "Drives comunes",
               description:
                 "Cumplimiento de los repositorios compartidos de Grupo ORVE.",
               drives: @common_drives,
               show_position: false,
               empty_message:
                 "No se encontraron Drives comunes activos." %>

    <%= render "drives_table",
               title: "Top 10 por cantidad de documentos",
               description:
                 "Drives personales con mayor cantidad de archivos. Se excluyen repositorios comunes y cuentas de servicio.",
               drives: @top_drives,
               show_position: true,
               empty_message:
                 "No se encontraron Drives para generar el ranking." %>
  </div>
</div>